{
  "name": "snebur-ui-docs-generator",
  "version": "1.0.0",
  "description": "Automated markdown documentation generator for Snebur.UI framework",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
